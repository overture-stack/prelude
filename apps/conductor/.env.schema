# =============================================================================
# ELASTICSEARCH
# =============================================================================

ELASTICSEARCH_URL=http://localhost:9200  # Full URL override — takes precedence over ES_HOST [optional]
ES_HOST=localhost:9200                   # Host and port — used when ELASTICSEARCH_URL is not set [optional]
ELASTICSEARCH_USER=elastic               # Username for basic auth [optional]
ELASTICSEARCH_PASSWORD=myelasticpassword # Password for basic auth [optional]

# =============================================================================
# POSTGRESQL
# =============================================================================

DB_HOST=localhost:5435      # Host and port [optional]
POSTGRES_DATABASE=overtureDb # Database name [optional]
POSTGRES_USERNAME=admin      # Username [optional]
POSTGRES_PASSWORD=admin123   # Password [optional]
POSTGRES_TABLE=data          # Default table name [optional]

# =============================================================================
# GENERAL
# =============================================================================

DEBUG=false  # Enable debug logging — set to "true" to activate [optional]
