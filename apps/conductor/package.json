{
  "name": "conductor",
  "version": "1.1.0",
  "description": "Data processing pipeline for Elasticsearch and associated services",
  "main": "dist/main.js",
  "bin": {
    "conductor": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/main.js",
    "dev": "ts-node src/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "elasticsearch",
    "data-processing",
    "csv",
    "cli"
  ],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "@elastic/elasticsearch": "^7.17.0",
    "chalk": "^4.1.2",
    "commander": "^9.4.1",
    "csv-parse": "^5.3.3",
    "pg": "^8.16.3",
    "pg-cursor": "^2.15.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/chalk": "^2.2.0",
    "@types/node": "^18.19.129",
    "@types/pg": "^8.15.5",
    "@types/pg-cursor": "^2.7.2",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^1.6.0",
    "ts-node": "^10.9.0",
    "typescript": "^4.9.5",
    "vitest": "^1.6.0"
  }
}
