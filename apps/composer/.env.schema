# =============================================================================
# INPUT / OUTPUT
# =============================================================================

FILES=file1.csv,file2.csv  # Comma-separated input file paths [optional]
OUTPUT_PATH=./configs       # Output directory or file path [optional]

# =============================================================================
# LECTERN DICTIONARY
# =============================================================================

DICTIONARY_NAME=lectern_dictionary            # Dictionary name [optional]
DICTIONARY_DESC=Generated dictionary from CSV # Dictionary description [optional]
DICTIONARY_VERSION=1.0.0                      # Dictionary version [optional]

# =============================================================================
# SONG SCHEMA
# =============================================================================

SCHEMA_NAME=song_schema   # Schema name [optional]
FILE_TYPES=bam vcf fastq  # Space-separated list of allowed file types [optional]

# =============================================================================
# ELASTICSEARCH
# =============================================================================

ES_INDEX=data                    # Elasticsearch index name [optional]
ES_SHARDS=1                      # Number of shards [optional]
ES_REPLICAS=1                    # Number of replicas [optional]
ES_IGNORED_FIELDS=field1 field2  # Space-separated fields to exclude from mapping [optional]
ES_IGNORED_SCHEMAS=schema1       # Space-separated Lectern schemas to exclude [optional]
ES_SKIP_METADATA=false           # Skip adding submission_metadata to mapping [optional]

# =============================================================================
# CSV
# =============================================================================

CSV_DELIMITER=,  # CSV delimiter character [optional]

# =============================================================================
# ARRANGER
# =============================================================================

ARRANGER_DOC_TYPE=file  # Arranger document type: "file" or "analysis" [optional]

# =============================================================================
# POSTGRESQL
# =============================================================================

POSTGRES_TABLE_NAME=generated_table  # Target PostgreSQL table name [optional]
