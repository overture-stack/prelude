# ── Git ──────────────────────────────────────────────────────────────── #
.git

# ── Conductor build artefacts (rebuilt inside the container) ─────────── #
apps/conductor/node_modules
apps/conductor/dist

# ── Stage build artefacts (rebuilt inside the container) ─────────────── #
apps/stage/node_modules
apps/stage/.next
apps/stage/tsconfig.tsbuildinfo
apps/stage/.env.local
apps/stage/.env.test
apps/stage/.env.schema

# ── Workshop data and infrastructure scripts ─────────────────────────── #
data
setup

# ── Vendored Arranger submodule: reference only, except its docs/ tree, ─ #
# ── which the Stage image copies into public/docs/arranger.              ─ #
apps/arranger
!apps/arranger/docs

# NOTE: docs/ and configs/lectern/ are intentionally NOT excluded.
# The Dockerfile copies them into public/docs and public/dictionary inside the image.
