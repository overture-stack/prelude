# =============================================================================
# Proxy Parameters — Shared settings for all proxied services
# =============================================================================
# This file is included by each "location" block in your site config via:
#
#     include proxy_params;
#
# It tells nginx HOW to forward requests to your backend services (Stage,
# Arranger, Elasticsearch, etc.). Without these settings, the backend
# services would not receive important information about the original
# request (like the client's real IP address).
#
# File location: /etc/nginx/proxy_params
# =============================================================================


# --- Timeouts ----------------------------------------------------------------
# These control how long nginx waits at each stage of talking to a backend.
# If any timeout is exceeded, nginx returns a 504 Gateway Timeout to the
# client. The 60-second defaults are generous — most requests complete in
# under a second, but large data exports or Elasticsearch queries can take
# longer.
#
# If you see 504 errors during large downloads or complex searches, try
# increasing these values (e.g. to 120s or 300s).

# How long to wait for the initial TCP connection to the backend.
proxy_connect_timeout 60s;

# How long to wait between successive write operations when sending the
# request body to the backend (not total transfer time).
proxy_send_timeout 60s;

# How long to wait between successive read operations when receiving the
# response from the backend (not total transfer time). This is the most
# common timeout to hit — a slow Elasticsearch query will trigger this.
proxy_read_timeout 60s;


# --- Buffering ---------------------------------------------------------------
# When buffering is on, nginx reads the entire response from the backend
# into memory (or a temp file) before sending it to the client. This frees
# up the backend connection quickly, which is important because backend
# services typically handle fewer concurrent connections than nginx can.
#
# If you're proxying large file downloads or streaming responses, you may
# want to turn buffering off (proxy_buffering off;) for those specific
# location blocks.

# Enable response buffering (recommended for API/web traffic).
proxy_buffering on;

# Size of the buffer for reading the first part of the response (headers).
proxy_buffer_size 8k;

# Number and size of buffers for reading the response body.
# 8 buffers x 8KB = 64KB max in-memory buffering per request.
# Responses larger than this spill to a temporary file on disk.
proxy_buffers 8 8k;


# --- Headers -----------------------------------------------------------------
# When nginx proxies a request, the backend sees nginx as the client, not
# the actual user. These headers pass along the original request information
# so backend services can log the real client IP, generate correct URLs, etc.

# Passes the original Host header (e.g. "portal.yourlab.org") to the backend.
# Without this, the backend sees "localhost:3000" as the host, which breaks
# URL generation and cookie domains.
proxy_set_header Host $host;

# The actual IP address of the client (not nginx's IP). Backend services
# use this for logging and rate limiting.
proxy_set_header X-Real-IP $remote_addr;

# A comma-separated list of all proxies the request has passed through.
# If the client went through a CDN or load balancer before reaching nginx,
# those IPs are already in this header, and nginx appends its own.
proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

# Tells the backend whether the original request was HTTP or HTTPS.
# Critical for applications that generate redirect URLs or set secure
# cookies — without this, a backend behind nginx might generate "http://"
# links even though the user is on "https://".
proxy_set_header X-Forwarded-Proto $scheme;


# --- WebSocket Support -------------------------------------------------------
# WebSockets use a different protocol than regular HTTP. The initial request
# is a normal HTTP request with an "Upgrade" header, asking to switch to the
# WebSocket protocol. These settings ensure nginx passes that upgrade request
# through to the backend instead of stripping it.
#
# Even if your portal doesn't use WebSockets today, these settings are
# harmless for regular HTTP traffic and avoid hard-to-debug issues if a
# future service needs them.

# Use HTTP/1.1 for the connection to the backend (required for WebSocket
# upgrade). The default (HTTP/1.0) does not support the Upgrade mechanism.
proxy_http_version 1.1;

# Forward the Upgrade header from the client to the backend.
proxy_set_header Upgrade $http_upgrade;

# Switch the connection type to "upgrade" so nginx keeps the connection
# open for bidirectional WebSocket traffic instead of closing it after
# the response.
proxy_set_header Connection "upgrade";
