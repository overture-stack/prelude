# =============================================================================
# Prelude Portal — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#
#   cp .env.example .env
#
# The .env file is git-ignored and should NEVER be committed to version control.
# Docker Compose reads it automatically from the project root.
#
# For the workshop demo, the defaults below work out of the box.
# For production, generate strong random values for all passwords and secrets.
# =============================================================================

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=overtureDb

# --- Elasticsearch -----------------------------------------------------------
ES_USER=elastic
ES_PASSWORD=myelasticpassword

# --- Stage (NextAuth) --------------------------------------------------------
# NEXTAUTH_SECRET must be a random string. Generate one with:
#   openssl rand -base64 48
NEXTAUTH_SECRET=your-secure-secret-here

# --- CORS (production only) --------------------------------------------------
# Comma-separated list of allowed origins. Leave empty to allow all (dev only).
# Example: https://portal.yourlab.org
# CORS_ALLOWED_ORIGIN=

# --- Portal Display ----------------------------------------------------------
NEXT_PUBLIC_LAB_NAME=My Data Portal
NEXT_PUBLIC_ADMIN_EMAIL=admin@example.org
