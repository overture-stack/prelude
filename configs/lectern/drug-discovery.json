        {
          "name": "number_of_samples_with_losses",
          "meta": {
            "displayName": "Samples with Losses"
          },
          "description": "Number of samples with a copy-number loss at this gene.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "total_number_of_samples",
          "meta": {
            "displayName": "Total Samples"
          },
          "description": "Total number of samples in the cohort.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "percent_of_samples_with_gains",
          "meta": {
            "displayName": "% Samples with Gains"
          },
          "description": "Percentage of samples with a copy-number gain at this gene (0-100).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 100
            }
          }
        },
        {
          "name": "percent_of_samples_with_losses",
          "meta": {
            "displayName": "% Samples with Losses"
          },
          "description": "Percentage of samples with a copy-number loss at this gene (0-100).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 100
            }
          }
        },
        {
          "name": "dataset_name",
          "meta": {
            "displayName": "Dataset Name"
          },
          "description": "Source dataset the record was derived from.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "is_oncogene",
          "meta": {
            "displayName": "Is Oncogene"
          },
          "description": "Whether the gene is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": [
              "Yes",
              "No"
            ]
          }
        },
        {
          "name": "is_tumor_suppressor_gene",
          "meta": {
            "displayName": "Is Tumor Suppressor"
          },
          "description": "Whether the gene is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": [
              "Yes",
              "No"
            ]
          }
        }
      ]
    },
    {
      "name": "protein",
      "meta": {
        "displayName": "Protein Interaction"
      },
      "description": "STRING protein-protein interaction evidence channel scores (0-1000) per gene pair.",
      "fields": [
        {
          "name": "hugo_symbol_a",
          "meta": {
            "displayName": "Gene A HUGO Symbol"
          },
          "description": "HUGO gene symbol for the first interaction partner.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "hugo_symbol_b",
          "meta": {
            "displayName": "Gene B HUGO Symbol"
          },
          "description": "HUGO gene symbol for the second interaction partner.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "neighborhood",
          "meta": {
            "displayName": "Neighborhood"
          },
          "description": "Genomic neighborhood evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "neighborhood_transferred",
