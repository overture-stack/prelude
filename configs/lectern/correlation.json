{
  "name": "drug_discovery_correlation",
  "version": "1.0",
  "description": "Gene-gene co-expression correlation results for the drug discovery data portal.",
  "schemas": [
    {
      "name": "correlation",
      "meta": {
        "displayName": "Correlation"
      },
      "description": "Pairwise gene co-expression correlation statistics per cancer type.",
      "fields": [
        {
          "name": "n",
          "meta": {
            "displayName": "Sample Count"
          },
          "description": "Number of samples used to compute the correlation.",
          "valueType": "integer",
          "restrictions": {
            "required": true,
            "range": {
              "min": 1
            }
          }
        },
        {
          "name": "hugo_symbol_a",
          "meta": {
            "displayName": "Gene A HUGO Symbol"
          },
          "description": "HUGO gene symbol for gene A.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "entrez_gene_id_a",
          "meta": {
            "displayName": "Gene A Entrez ID"
          },
          "description": "Entrez Gene ID for gene A.",
          "valueType": "integer",
          "restrictions": {
            "required": true,
            "range": {
              "min": 1
            }
          }
        },
        {
          "name": "hugo_symbol_b",
          "meta": {
            "displayName": "Gene B HUGO Symbol"
          },
          "description": "HUGO gene symbol for gene B.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "entrez_gene_id_b",
          "meta": {
            "displayName": "Gene B Entrez ID"
          },
          "description": "Entrez Gene ID for gene B.",
          "valueType": "integer",
          "restrictions": {
            "required": true,
            "range": {
              "min": 1
            }
          }
        },
        {
          "name": "spearmancorr",
          "meta": {
            "displayName": "Spearman Correlation"
          },
          "description": "Spearman rank correlation coefficient between gene A and gene B.",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": -1,
              "max": 1
            }
          }
        },
        {
          "name": "spearmanp",
          "meta": {
            "displayName": "Spearman p-value"
          },
          "description": "P-value for the Spearman correlation.",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1
            }
          }
        },
        {
          "name": "pearsoncorr",
          "meta": {
            "displayName": "Pearson Correlation"
          },
          "description": "Pearson correlation coefficient between gene A and gene B.",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": -1,
              "max": 1
            }
          }
        },
        {
          "name": "pearsonp",
          "meta": {
            "displayName": "Pearson p-value"
          },
          "description": "P-value for the Pearson correlation.",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1
            }
          }
        },
        {
          "name": "spearmancorrsquare",
          "meta": {
            "displayName": "Spearman R²"
          },
          "description": "Squared Spearman correlation coefficient (coefficient of determination).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1
            }
          }
        },
        {
          "name": "pearsoncorrsquare",
          "meta": {
            "displayName": "Pearson R²"
          },
          "description": "Squared Pearson correlation coefficient (coefficient of determination).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1
            }
          }
        },
        {
          "name": "cancer_type",
          "meta": {
            "displayName": "Cancer Type"
          },
          "description": "Cancer type abbreviation for the cohort the correlation was computed in.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "dataset_name",
          "meta": {
            "displayName": "Dataset Name"
          },
          "description": "Source dataset the record was derived from.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "is_oncogene_a",
          "meta": {
            "displayName": "Gene A Is Oncogene"
          },
          "description": "Whether gene A is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_tumor_suppressor_gene_a",
          "meta": {
            "displayName": "Gene A Is Tumor Suppressor"
          },
          "description": "Whether gene A is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_oncogene_b",
          "meta": {
            "displayName": "Gene B Is Oncogene"
          },
          "description": "Whether gene B is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_tumor_suppressor_gene_b",
          "meta": {
            "displayName": "Gene B Is Tumor Suppressor"
          },
          "description": "Whether gene B is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        }
      ]
    }
  ]
}
