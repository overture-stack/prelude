{
  "name": "drug_discovery_expression",
  "version": "1.0",
  "description": "Per-gene average expression results for the drug discovery data portal.",
  "schemas": [
    {
      "name": "expression",
      "meta": {
        "displayName": "Expression"
      },
      "description": "Gene-level average expression per cancer type.",
      "fields": [
        {
          "name": "entrez_gene_id",
          "meta": {
            "displayName": "Entrez Gene ID"
          },
          "description": "Entrez Gene ID.",
          "valueType": "integer",
          "restrictions": {
            "required": true,
            "range": {
              "min": 1
            }
          }
        },
        {
          "name": "hugo_symbol",
          "meta": {
            "displayName": "HUGO Symbol"
          },
          "description": "HUGO gene symbol.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "average_expression",
          "meta": {
            "displayName": "Average Expression"
          },
          "description": "Mean expression value across tumour samples in the cohort.",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "number_of_tumour_samples",
          "meta": {
            "displayName": "Tumour Sample Count"
          },
          "description": "Number of tumour samples the average expression was computed over.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "cancer_type",
          "meta": {
            "displayName": "Cancer Type"
          },
          "description": "Cancer type abbreviation for the cohort.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "dataset_name",
          "meta": {
            "displayName": "Dataset Name"
          },
          "description": "Source dataset the record was derived from.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "is_oncogene",
          "meta": {
            "displayName": "Is Oncogene"
          },
          "description": "Whether the gene is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_tumor_suppressor_gene",
          "meta": {
            "displayName": "Is Tumor Suppressor"
          },
          "description": "Whether the gene is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        }
      ]
    }
  ]
}
