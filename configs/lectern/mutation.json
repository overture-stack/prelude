{
  "name": "drug_discovery_mutation",
  "version": "1.0",
  "description": "Per-gene mutation and copy-number frequency results for the drug discovery data portal.",
  "schemas": [
    {
      "name": "mutation",
      "meta": {
        "displayName": "Mutation"
      },
      "description": "Gene-level mutation and copy-number alteration frequencies per cancer type.",
      "fields": [
        {
          "name": "hugo_symbol",
          "meta": {
            "displayName": "HUGO Symbol"
          },
          "description": "HUGO gene symbol.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "entrez_gene_id",
          "meta": {
            "displayName": "Entrez Gene ID"
          },
          "description": "Entrez Gene ID.",
          "valueType": "integer",
          "restrictions": {
            "required": true,
            "range": {
              "min": 1
            }
          }
        },
        {
          "name": "number_of_samples_mutated_at_gene",
          "meta": {
            "displayName": "Samples Mutated at Gene"
          },
          "description": "Number of samples carrying a mutation at this gene.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "total_number_of_mutated_samples",
          "meta": {
            "displayName": "Total Mutated Samples"
          },
          "description": "Total number of mutated samples in the cohort.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "overall_mutation_frequency",
          "meta": {
            "displayName": "Overall Mutation Frequency"
          },
          "description": "Percentage of samples mutated at this gene (0-100).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 100
            }
          }
        },
        {
          "name": "cancer_type",
          "meta": {
            "displayName": "Cancer Type"
          },
          "description": "Cancer type abbreviation for the cohort.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "number_of_samples_with_gains",
          "meta": {
            "displayName": "Samples with Gains"
          },
          "description": "Number of samples with a copy-number gain at this gene.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "number_of_samples_with_losses",
          "meta": {
            "displayName": "Samples with Losses"
          },
          "description": "Number of samples with a copy-number loss at this gene.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "total_number_of_samples",
          "meta": {
            "displayName": "Total Samples"
          },
          "description": "Total number of samples in the cohort.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0
            }
          }
        },
        {
          "name": "percent_of_samples_with_gains",
          "meta": {
            "displayName": "% Samples with Gains"
          },
          "description": "Percentage of samples with a copy-number gain at this gene (0-100).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 100
            }
          }
        },
        {
          "name": "percent_of_samples_with_losses",
          "meta": {
            "displayName": "% Samples with Losses"
          },
          "description": "Percentage of samples with a copy-number loss at this gene (0-100).",
          "valueType": "number",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 100
            }
          }
        },
        {
          "name": "dataset_name",
          "meta": {
            "displayName": "Dataset Name"
          },
          "description": "Source dataset the record was derived from.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "is_oncogene",
          "meta": {
            "displayName": "Is Oncogene"
          },
          "description": "Whether the gene is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_tumor_suppressor_gene",
          "meta": {
            "displayName": "Is Tumor Suppressor"
          },
          "description": "Whether the gene is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        }
      ]
    }
  ]
}
