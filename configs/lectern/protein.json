{
  "name": "drug_discovery_protein",
  "version": "1.0",
  "description": "Protein-protein interaction association scores for the drug discovery data portal.",
  "schemas": [
    {
      "name": "protein",
      "meta": {
        "displayName": "Protein Interaction"
      },
      "description": "STRING protein-protein interaction evidence channel scores (0-1000) per gene pair.",
      "fields": [
        {
          "name": "hugo_symbol_a",
          "meta": {
            "displayName": "Gene A HUGO Symbol"
          },
          "description": "HUGO gene symbol for the first interaction partner.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "hugo_symbol_b",
          "meta": {
            "displayName": "Gene B HUGO Symbol"
          },
          "description": "HUGO gene symbol for the second interaction partner.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "neighborhood",
          "meta": {
            "displayName": "Neighborhood"
          },
          "description": "Genomic neighborhood evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "neighborhood_transferred",
          "meta": {
            "displayName": "Neighborhood (Transferred)"
          },
          "description": "Genomic neighborhood evidence score transferred from other organisms.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "fusion",
          "meta": {
            "displayName": "Fusion"
          },
          "description": "Gene fusion evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "cooccurence",
          "meta": {
            "displayName": "Co-occurrence"
          },
          "description": "Phylogenetic co-occurrence evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "homology",
          "meta": {
            "displayName": "Homology"
          },
          "description": "Homology evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "coexpression",
          "meta": {
            "displayName": "Co-expression"
          },
          "description": "Co-expression evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "coexpression_transferred",
          "meta": {
            "displayName": "Co-expression (Transferred)"
          },
          "description": "Co-expression evidence score transferred from other organisms.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "experiments",
          "meta": {
            "displayName": "Experiments"
          },
          "description": "Experimental / biochemical evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "experiments_transferred",
          "meta": {
            "displayName": "Experiments (Transferred)"
          },
          "description": "Experimental evidence score transferred from other organisms.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "database",
          "meta": {
            "displayName": "Database"
          },
          "description": "Curated database evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "database_transferred",
          "meta": {
            "displayName": "Database (Transferred)"
          },
          "description": "Curated database evidence score transferred from other organisms.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "textmining",
          "meta": {
            "displayName": "Text Mining"
          },
          "description": "Literature text-mining evidence score.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "textmining_transferred",
          "meta": {
            "displayName": "Text Mining (Transferred)"
          },
          "description": "Literature text-mining evidence score transferred from other organisms.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "combined_score",
          "meta": {
            "displayName": "Combined Score"
          },
          "description": "Combined STRING association score across all evidence channels.",
          "valueType": "integer",
          "restrictions": {
            "range": {
              "min": 0,
              "max": 1000
            }
          }
        },
        {
          "name": "dataset_name",
          "meta": {
            "displayName": "Dataset Name"
          },
          "description": "Source dataset the record was derived from.",
          "valueType": "string",
          "restrictions": {
            "required": true
          }
        },
        {
          "name": "is_oncogene_a",
          "meta": {
            "displayName": "Gene A Is Oncogene"
          },
          "description": "Whether gene A is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_tumor_suppressor_gene_a",
          "meta": {
            "displayName": "Gene A Is Tumor Suppressor"
          },
          "description": "Whether gene A is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_oncogene_b",
          "meta": {
            "displayName": "Gene B Is Oncogene"
          },
          "description": "Whether gene B is annotated as an oncogene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        },
        {
          "name": "is_tumor_suppressor_gene_b",
          "meta": {
            "displayName": "Gene B Is Tumor Suppressor"
          },
          "description": "Whether gene B is annotated as a tumor suppressor gene.",
          "valueType": "string",
          "restrictions": {
            "codeList": ["Yes", "No"]
          }
        }
      ]
    }
  ]
}
